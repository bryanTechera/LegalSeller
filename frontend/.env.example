# ── Base de datos ─────────────────────────────────────────────────────────────
# Postgres compartida con el backend de agentes (requiere pgvector + pgcrypto).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalseller

# Límite de conexiones del pool de Prisma (1-100, default 10).
# PRISMA_CONNECTION_LIMIT=10

# ── Backend de agentes ────────────────────────────────────────────────────────
# URL del servicio Mastra. Default: http://localhost:4112
# MASTRA_BASE_URL=http://localhost:4112

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error (default: info)
# LOG_LEVEL=info

# ── Versión de la app ─────────────────────────────────────────────────────────
# Expuesta al browser; la reporta GET /api/health. Default: "dev".
# NEXT_PUBLIC_APP_VERSION=

# ── Board de administración (/board) — auth por email autorizado ──────────────
# Sesión Auth.js (JWT 7 días). Generar con: npx auth secret
# AUTH_SECRET=
# Lista de emails separada por comas; vacía o ausente = nadie entra (fail-closed).
# ALLOWED_EMAILS=
# Cuenta de Resend para el magic link; el dominio de EMAIL_FROM debe estar verificado ahí.
# RESEND_API_KEY=
# EMAIL_FROM="Jurco <no-reply@tu-dominio.com>"

# ── Runner de escenarios (equipo legal) ───────────────────────────────────────
# Credencial de servicio para /api/revision/*, usada por `pnpm escenario`. Ya no
# es una clave que un humano tipea: los humanos entran al board por email (arriba).
# Sin ella la feature queda apagada (acceso responde 503); rotarla revoca todas
# las cookies emitidas.
# REVISION_CLAVE=
